# Browser-safe values (Supabase dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Path the site is served from on GitHub Pages: /<repo-name>/
VITE_BASE=/thailand-trip/

# --- NEVER put these in a VITE_ variable or commit them ---
# Used only by scripts/provision-users.mjs, exported in your own shell:
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
